.PHONY: help build deploy test monitor clean logs stop start restart

# Default environment
ENV ?= development

# Docker compose files
COMPOSE_DEV = docker-compose.bff.yml
COMPOSE_PROD = docker-compose.bff.prod.yml
COMPOSE_TEST = docker-compose.bff.test.yml

# Select compose file based on environment
ifeq ($(ENV),production)
	COMPOSE_FILE = $(COMPOSE_PROD)
else ifeq ($(ENV),test)
	COMPOSE_FILE = $(COMPOSE_TEST)
else
	COMPOSE_FILE = $(COMPOSE_DEV)
endif

help: ## Show this help message
	@echo "Docker BFF Architecture Management"
	@echo ""
	@echo "Usage: make [target] [ENV=environment]"
	@echo ""
	@echo "Environments: development (default), production, test"
	@echo ""
	@echo "Targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

build: ## Build Docker images
	@echo "Building Docker images for $(ENV) environment..."
	docker-compose -f $(COMPOSE_FILE) build --no-cache

deploy: ## Deploy services
	@echo "Deploying services for $(ENV) environment..."
	./docker/scripts/deploy.sh $(ENV)

start: ## Start services
	@echo "Starting services for $(ENV) environment..."
	docker-compose -f $(COMPOSE_FILE) up -d

stop: ## Stop services
	@echo "Stopping services for $(ENV) environment..."
	docker-compose -f $(COMPOSE_FILE) down

restart: stop start ## Restart services

logs: ## View logs
	docker-compose -f $(COMPOSE_FILE) logs -f

test: ## Run tests
	@echo "Running tests for $(ENV) environment..."
	./docker/scripts/test.sh $(ENV)

monitor: ## Monitor services
	./docker/scripts/monitor.sh $(ENV)

clean: ## Remove containers, volumes, and images
	@echo "Cleaning up $(ENV) environment..."
	docker-compose -f $(COMPOSE_FILE) down -v --rmi all

ps: ## Show service status
	docker-compose -f $(COMPOSE_FILE) ps

health: ## Check health of all services
	@echo "Checking service health..."
	@curl -s http://localhost:4001/health | jq '.' || echo "User Management BFF: Unhealthy"
	@curl -s http://localhost:4006/health | jq '.' || echo "Catalog BFF: Unhealthy"
	@curl -s http://localhost:4005/health | jq '.' || echo "Orders BFF: Unhealthy"

validate: ## Validate full stack (7/7 services)
	@echo "Validating full stack..."
	@./docker/scripts/test.sh $(ENV)
	@echo "✅ Validation complete"

# Production targets
prod-build: ENV=production
prod-build: build ## Build production images

prod-deploy: ENV=production
prod-deploy: deploy ## Deploy production

prod-test: ENV=production
prod-test: test ## Test production

# Test targets
test-build: ENV=test
test-build: build ## Build test images

test-deploy: ENV=test
test-deploy: deploy ## Deploy test environment

test-test: ENV=test
test-test: test ## Run tests

