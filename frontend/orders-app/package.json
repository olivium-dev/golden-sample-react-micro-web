{
  "name": "orders-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^6.20.4",
    "@tanstack/react-query": "^5.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "msw": "^2.11.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.21.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "dotenv": "^16.3.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "concurrently": "^8.2.0"
  },
  "scripts": {
    "start": "webpack serve --config webpack.config.js --mode development",
    "start:bff": "node server/server.js",
    "start:dev": "concurrently \"npm start\" \"npm run start:bff\"",
    "build": "webpack --config webpack.config.js --mode production",
    "build:bff": "npm run build && NODE_ENV=production npm run start:bff",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start:standalone": "webpack serve --config webpack.standalone.config.js --port 3101",
    "build:standalone": "webpack --config webpack.standalone.config.js --mode production",
    "start:isolated": "webpack serve --config webpack.isolated.config.js --port 3101",
    "build:isolated": "webpack --config webpack.isolated.config.js --mode production"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
